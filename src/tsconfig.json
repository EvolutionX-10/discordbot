{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"#lib/*": ["./lib/*"],
			"#core": ["./core/index.ts"],
			"#root/*": ["./*"]
		},
		"rootDir": ".",
		"allowJs": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": false,
		"skipLibCheck": true,
		"types": ["bun", "node"]
	}
}
