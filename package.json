{
	"name": "discordbot",
	"version": "1.7.1",
	"main": "src/index.ts",
	"author": {
		"name": "EvolutionX-10",
		"url": "https://github.com/EvolutionX-10"
	},
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*/index.ts",
		"#core": "./src/core/index.ts",
		"#root/*": "./src/*.ts"
	},
	"scripts": {
		"dev": "bun --watch .",
		"start": "bun .",
		"typecheck": "tsc --noEmit -p src/tsconfig.json",
		"format:check": "prettier --check .",
		"test": "bun test"
	},
	"dependencies": {
		"colorette": "2.0.20",
		"discord-api-types": "0.38.60",
		"discord.js": "14.28.1"
	},
	"devDependencies": {
		"prettier": "3.10.1",
		"typescript": "7.0.2",
		"@types/node": "26.6.6",
		"@types/bun": "1.4.5"
	},
	"packageManager": "bun@1.4.5"
}
